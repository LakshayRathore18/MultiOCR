# Environment variables for Multi-Model OCR Application
# Copy this file to .env and update with your actual credentials

# Database Configuration
DB_NAME=your_database_name
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# GPU Configuration
# Set to true if you have CUDA-compatible GPU for faster OCR processing
USE_GPU=false

# Deepseek API Configuration
DEEPSEEK_API_URL=http://localhost:11434/api/chat
DEEPSEEK_MODEL=deepseek-ocr